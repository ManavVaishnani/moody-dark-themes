{
  "$schema": "vscode://schemas/color-theme",
  "name": "Moody Dark Forest",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#C8D1CC",
      "fontStyle": "italic"
    },
    "variable.readonly": {
      "foreground": "#E2C8A2"
    },
    "variable.defaultLibrary": {
      "foreground": "#D8B589"
    },
    "typeParameter": {
      "foreground": "#D8B589",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#D8B589"
    },
    "property.declaration": {
      "foreground": "#C8D1CC"
    },
    "enumMember": {
      "foreground": "#E2C8A2"
    }
  },
  "colors": {
    "editor.background": "#131916",
    "editor.foreground": "#C8D1CC",
    "editorLineNumber.foreground": "#53685D",
    "editorLineNumber.activeForeground": "#8CA094",
    "editor.lineHighlightBackground": "#1A221E",
    "editor.lineHighlightBorder": "#00000000",
    "editorCursor.foreground": "#E6ECE8",
    "editor.selectionBackground": "#243B30",
    "editor.inactiveSelectionBackground": "#1B2C24",
    "editor.selectionHighlightBackground": "#243B30AA",
    "editor.wordHighlightBackground": "#243B30AA",
    "editor.wordHighlightStrongBackground": "#2D4B3DAA",
    "editor.findMatchBackground": "#2E5142",
    "editor.findMatchBorder": "#7FB592",
    "editor.findMatchHighlightBackground": "#243B30AA",
    "editorWhitespace.foreground": "#222D27",
    "editorIndentGuide.background1": "#222D27",
    "editorIndentGuide.activeBackground1": "#53685D",
    "editorRuler.foreground": "#222D27",
    "editorBracketMatch.background": "#243B30",
    "editorBracketMatch.border": "#7FB592",
    "editorBracketHighlight.foreground1": "#7FB592",
    "editorBracketHighlight.foreground2": "#D8B589",
    "editorBracketHighlight.foreground3": "#88C0D0",
    "editorBracketHighlight.foreground4": "#DDA185",
    "editorBracketHighlight.foreground5": "#7FB592",
    "editorBracketHighlight.foreground6": "#D8B589",
    "editorInlayHint.background": "#1A221E",
    "editorInlayHint.foreground": "#7A9184",
    "editorCodeLens.foreground": "#7A9184",
    "editorLink.activeForeground": "#7FB592",
    "editorOverviewRuler.border": "#00000000",
    "editorGutter.modifiedBackground": "#D8B589",
    "editorGutter.addedBackground": "#7FB592",
    "editorGutter.deletedBackground": "#D97D75",
    "editorError.foreground": "#D97D75",
    "editorWarning.foreground": "#D8B589",
    "editorInfo.foreground": "#88C0D0",
    "editorHint.foreground": "#7A9184",
    "errorForeground": "#D97D75",
    "editorUnnecessaryCode.opacity": "#00000088",
    "editorStickyScroll.background": "#131916",
    "editorStickyScrollHover.background": "#1A221E",
    "editorWidget.background": "#101613",
    "editorWidget.border": "#212C26",
    "editorSuggestWidget.background": "#101613",
    "editorSuggestWidget.selectedBackground": "#243B30",
    "editorSuggestWidget.highlightForeground": "#DDA185",
    "editorSuggestWidget.focusHighlightForeground": "#DDA185",
    "editorHoverWidget.background": "#101613",
    "editorHoverWidget.border": "#212C26",
    "editorGroup.border": "#212C26",
    "editorGroupHeader.tabsBackground": "#0B0F0D",
    "editorGroupHeader.tabsBorder": "#212C26",
    "tab.activeBackground": "#131916",
    "tab.activeForeground": "#E6ECE8",
    "tab.inactiveBackground": "#0B0F0D",
    "tab.inactiveForeground": "#8CA094",
    "tab.border": "#212C26",
    "tab.activeBorderTop": "#546B5F",
    "tab.hoverBackground": "#1A221E",
    "focusBorder": "#7FB592",
    "foreground": "#C8D1CC",
    "descriptionForeground": "#8CA094",
    "disabledForeground": "#53685D",
    "widget.shadow": "#00000080",
    "selection.background": "#243B30",
    "icon.foreground": "#8CA094",
    "textLink.foreground": "#7FB592",
    "textLink.activeForeground": "#9BCBAE",
    "textPreformat.foreground": "#DDA185",
    "textBlockQuote.background": "#101613",
    "textCodeBlock.background": "#101613",
    "textSeparator.foreground": "#212C26",
    "titleBar.activeBackground": "#0F1412",
    "titleBar.activeForeground": "#C8D1CC",
    "titleBar.inactiveBackground": "#0F1412",
    "titleBar.inactiveForeground": "#53685D",
    "titleBar.border": "#212C26",
    "activityBar.background": "#0F1412",
    "activityBar.foreground": "#E6ECE8",
    "activityBar.inactiveForeground": "#53685D",
    "activityBar.border": "#212C26",
    "activityBar.activeBorder": "#7FB592",
    "activityBarBadge.background": "#7FB592",
    "activityBarBadge.foreground": "#0F1412",
    "sideBar.background": "#0F1412",
    "sideBar.foreground": "#C8D1CC",
    "sideBar.border": "#212C26",
    "sideBarTitle.foreground": "#E6ECE8",
    "sideBarSectionHeader.background": "#0F1412",
    "sideBarSectionHeader.foreground": "#E6ECE8",
    "sideBarSectionHeader.border": "#212C26",
    "list.activeSelectionBackground": "#243B30",
    "list.activeSelectionForeground": "#E6ECE8",
    "list.inactiveSelectionBackground": "#1B2C24",
    "list.inactiveSelectionForeground": "#C8D1CC",
    "list.hoverBackground": "#1A221E",
    "list.hoverForeground": "#E6ECE8",
    "list.highlightForeground": "#7FB592",
    "list.focusBackground": "#243B30",
    "list.focusForeground": "#E6ECE8",
    "list.dropBackground": "#243B30AA",
    "statusBar.background": "#0F1412",
    "statusBar.foreground": "#8CA094",
    "statusBar.border": "#212C26",
    "statusBar.debuggingBackground": "#D8B589",
    "statusBar.debuggingForeground": "#0F1412",
    "statusBar.noFolderBackground": "#0F1412",
    "statusBar.noFolderForeground": "#8CA094",
    "statusBarItem.activeBackground": "#1A221E",
    "statusBarItem.hoverBackground": "#1A221E",
    "statusBarItem.prominentBackground": "#1A221E",
    "statusBarItem.prominentHoverBackground": "#243B30",
    "statusBarItem.remoteBackground": "#7FB592",
    "statusBarItem.remoteForeground": "#0F1412",
    "panel.background": "#0F1412",
    "panel.border": "#212C26",
    "panelTitle.activeBorder": "#7FB592",
    "panelTitle.activeForeground": "#E6ECE8",
    "panelTitle.inactiveForeground": "#53685D",
    "terminal.background": "#0F1412",
    "terminal.foreground": "#C8D1CC",
    "terminal.border": "#212C26",
    "terminal.ansiBlack": "#0F1412",
    "terminal.ansiBrightBlack": "#53685D",
    "terminal.ansiRed": "#D97D75",
    "terminal.ansiBrightRed": "#E5958F",
    "terminal.ansiGreen": "#7FB592",
    "terminal.ansiBrightGreen": "#9BCBAE",
    "terminal.ansiYellow": "#D8B589",
    "terminal.ansiBrightYellow": "#ECCFA9",
    "terminal.ansiBlue": "#7AA6B8",
    "terminal.ansiBrightBlue": "#9CC2D2",
    "terminal.ansiMagenta": "#B497BD",
    "terminal.ansiBrightMagenta": "#CCB5D4",
    "terminal.ansiCyan": "#78B5A2",
    "terminal.ansiBrightCyan": "#98D1BF",
    "terminal.ansiWhite": "#C8D1CC",
    "terminal.ansiBrightWhite": "#E6ECE8",
    "gitDecoration.modifiedResourceForeground": "#D8B589",
    "gitDecoration.addedResourceForeground": "#7FB592",
    "gitDecoration.untrackedResourceForeground": "#7FB592",
    "gitDecoration.deletedResourceForeground": "#D97D75",
    "gitDecoration.ignoredResourceForeground": "#53685D",
    "gitDecoration.conflictingResourceForeground": "#D97D75",
    "gitDecoration.stageModifiedResourceForeground": "#D8B589",
    "gitDecoration.stageDeletedResourceForeground": "#D97D75",
    "gitDecoration.submoduleResourceForeground": "#8CA094",
    "diffEditor.insertedTextBackground": "#7FB59226",
    "diffEditor.insertedLineBackground": "#7FB59214",
    "diffEditor.removedTextBackground": "#D97D7526",
    "diffEditor.removedLineBackground": "#D97D7514",
    "peekView.border": "#7FB592",
    "peekViewEditor.background": "#101613",
    "peekViewResult.background": "#0F1412",
    "peekViewTitle.background": "#0F1412",
    "peekViewTitleLabel.foreground": "#E6ECE8",
    "peekViewTitleDescription.foreground": "#8CA094",
    "breadcrumb.foreground": "#53685D",
    "breadcrumb.focusForeground": "#C8D1CC",
    "breadcrumb.activeSelectionForeground": "#E6ECE8",
    "breadcrumbPicker.background": "#101613",
    "quickInput.background": "#101613",
    "quickInput.foreground": "#C8D1CC",
    "pickerGroup.border": "#212C26",
    "pickerGroup.foreground": "#7FB592",
    "input.background": "#101613",
    "input.border": "#212C26",
    "input.foreground": "#C8D1CC",
    "input.placeholderForeground": "#53685D",
    "inputOption.activeBorder": "#7FB592",
    "button.background": "#243B30",
    "button.foreground": "#E6ECE8",
    "button.hoverBackground": "#2D4B3D",
    "badge.background": "#7FB592",
    "badge.foreground": "#0F1412",
    "progressBar.background": "#7FB592",
    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#53685D33",
    "scrollbarSlider.hoverBackground": "#53685D66",
    "scrollbarSlider.activeBackground": "#53685D99",
    "notificationCenterHeader.background": "#101613",
    "notifications.background": "#101613",
    "notifications.border": "#212C26",
    "notificationToast.border": "#212C26",
    "notifications.foreground": "#C8D1CC"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring",
        "storage.type.class.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#63786E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other.unit",
        "keyword.control.at-rule",
        "keyword.operator.logical.python",
        "storage.type.function.python",
        "storage.type.class.python",
        "variable.language",
        "variable.parameter.function.language.special.self.python",
        "keyword.control.as",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#7FB592",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "keyword.operator.type.annotation",
        "keyword.operator.assignment",
        "keyword.operator.arrow",
        "punctuation.accessor",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end",
        "punctuation.definition.markdown",
        "punctuation.definition.table.markdown",
        "meta.separator.markdown",
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#8CA094",
        "fontStyle": ""
      }
    },
    {
      "name": "Identifiers",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.property",
        "variable.other.constant",
        "variable.parameter",
        "meta.object-literal.key",
        "support.variable",
        "support.variable.property",
        "support.constant",
        "support.type.property-name",
        "support.type.property-name.css",
        "meta.template.expression",
        "meta.embedded",
        "meta.jsx.children",
        "variable.other.normal.shell",
        "variable.css",
        "string.other.link.title"
      ],
      "settings": {
        "foreground": "#C8D1CC",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and decorators",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.definition.method entity.name.function",
        "support.function.builtin",
        "support.function.misc.css",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.decorator",
        "entity.name.function.decorator.python",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "source.css entity.name.tag",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#88C0D0",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "entity.name.type.alias",
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type.enum",
        "support.class.component",
        "support.type.python",
        "storage.type.sql"
      ],
      "settings": {
        "foreground": "#D8B589",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "string.unquoted.plain.out.yaml",
        "markup.inline.raw",
        "markup.raw",
        "support.constant.property-value.css",
        "support.constant.font-name.css",
        "meta.property-value.css",
        "string.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#DDA185",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers, constants, escapes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other.color",
        "keyword.other.unit.css",
        "variable.other.enummember",
        "entity.name.constant",
        "constant.other.symbol",
        "constant.character.escape",
        "constant.other.character-class.regexp",
        "keyword.control.anchor.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#E2C8A2",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.yaml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7FB592",
        "fontStyle": ""
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#88C0D0"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#7FB592"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#E6ECE8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C8D1CC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C8D1CC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#53685D",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#7FB592",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#63786E",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown list marks",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#7FB592",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#7FB592",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#D97D75",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#D8B589",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#D97D75",
        "fontStyle": "underline"
      }
    }
  ]
}