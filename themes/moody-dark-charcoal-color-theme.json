    "type.defaultLibrary": "#9BB5D6",
    "function": "#A3CAE3",
    "method": "#A3CAE3",
    "member": "#A3CAE3",
    "function.defaultLibrary": "#A3CAE3",
    "method.defaultLibrary": "#A3CAE3",
    "decorator": "#A3CAE3",
    "variable": "#DDD9D0",
    "variable.readonly": "#E6E2D8",
    "variable.defaultLibrary": "#DDD9D0",
    "parameter": "#CFCBC2",
    "property": "#DDD9D0",
