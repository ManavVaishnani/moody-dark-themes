    "input.placeholderForeground": "#707070",
    "inputOption.activeBorder": "#7BA7F0",
    "inputOption.activeBackground": "#1E2A37",
    "inputValidation.errorBorder": "#EE857D",
    "inputValidation.warningBorder": "#F0CB8A",
    "inputValidation.infoBorder": "#7BA7F0",
    "dropdown.background": "#1A1A1A",
    "dropdown.border": "#2A2A2A",
    "dropdown.foreground": "#C9C9C9",
    "button.background": "#7BA7F0",
    "button.foreground": "#141414",
    "button.hoverBackground": "#A9D1EA",
    "button.secondaryBackground": "#2A2A2A",
    "button.secondaryForeground": "#C9C9C9",
    "button.secondaryHoverBackground": "#636363",
    "badge.background": "#7BA7F0",
    "badge.foreground": "#141414",
    "progressBar.background": "#F0A27F",
    "checkbox.background": "#1F1F1F",
    "checkbox.border": "#2A2A2A",
    "quickInput.background": "#1A1A1A",
    "quickInput.foreground": "#C9C9C9",
    "quickInputList.focusBackground": "#1E2A37",
    "quickInputTitle.background": "#1F1F1F",
    "pickerGroup.foreground": "#7BA7F0",
    "pickerGroup.border": "#2A2A2A",
    "menu.background": "#1A1A1A",
    "menu.foreground": "#C9C9C9",
    "menu.selectionBackground": "#1E2A37",
    "menu.selectionForeground": "#E8E8E8",
    "menu.border": "#2A2A2A",
    "menu.separatorBackground": "#2A2A2A",
    "notifications.background": "#1A1A1A",
    "notifications.border": "#2A2A2A",
    "notifications.foreground": "#C9C9C9",
    "notificationCenterHeader.background": "#1F1F1F",
    "notificationLink.foreground": "#7BA7F0",
    "scrollbarSlider.background": "#70707044",
    "scrollbarSlider.hoverBackground": "#70707077",
    "scrollbarSlider.activeBackground": "#707070AA",
    "scrollbar.shadow": "#00000060",
    "minimap.selectionHighlight": "#294058",
    "minimap.findMatchHighlight": "#344F6D",
    "minimap.errorHighlight": "#EE857D",
    "minimap.warningHighlight": "#F0CB8A",
    "breadcrumb.foreground": "#9A9A9A",
    "breadcrumb.focusForeground": "#D6D6D6",
    "breadcrumb.activeSelectionForeground": "#E8E8E8",
    "breadcrumbPicker.background": "#1A1A1A",
    "peekView.border": "#7BA7F0",
    "peekViewEditor.background": "#121212",
    "peekViewResult.background": "#1A1A1A",
    "peekViewTitle.background": "#1F1F1F",
    "peekViewResult.selectionBackground": "#1E2A37",
    "peekViewEditor.matchHighlightBackground": "#1E2A37",
    "gitDecoration.modifiedResourceForeground": "#F0CB8A",
    "gitDecoration.addedResourceForeground": "#8EB69B",
    "gitDecoration.untrackedResourceForeground": "#8EB69B",
    "gitDecoration.deletedResourceForeground": "#EE857D",
    "gitDecoration.ignoredResourceForeground": "#707070",
    "gitDecoration.conflictingResourceForeground": "#EE857D",
    "gitDecoration.stageModifiedResourceForeground": "#F0CB8A",
    "gitDecoration.stageDeletedResourceForeground": "#EE857D",
    "gitDecoration.submoduleResourceForeground": "#9A9A9A",
    "diffEditor.insertedTextBackground": "#8EB69B26",
    "diffEditor.removedTextBackground": "#EE857D26",
    "diffEditor.insertedLineBackground": "#8EB69B14",
    "diffEditor.removedLineBackground": "#EE857D14",
    "toolbar.hoverBackground": "#2A2A2A",
    "keybindingLabel.background": "#1F1F1F",
    "keybindingLabel.border": "#2A2A2A",
    "keybindingLabel.bottomBorder": "#2A2A2A",
    "keybindingLabel.foreground": "#C9C9C9",
    "settings.headerForeground": "#D6D6D6",
    "settings.modifiedItemIndicator": "#7BA7F0",
    "welcomePage.background": "#121212",
    "walkThrough.embeddedEditorBackground": "#121212",
    "sash.hoverBorder": "#7BA7F0",
    "commandCenter.background": "#1F1F1F",
    "commandCenter.border": "#2A2A2A",
    "commandCenter.foreground": "#9A9A9A",
    "commandCenter.activeBackground": "#2A2A2A"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring",
        "storage.type.class.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#8B8B8B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other.unit",
        "keyword.control.at-rule",
        "keyword.operator.logical.python",
        "storage.type.function.python",
        "storage.type.class.python",
        "variable.language",
        "variable.parameter.function.language.special.self.python",
        "keyword.control.as",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#7BA7F0",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "keyword.operator.type.annotation",
        "keyword.operator.assignment",
        "keyword.operator.arrow",
        "punctuation.accessor",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end",
        "punctuation.definition.markdown",
        "punctuation.definition.table.markdown",
        "meta.separator.markdown",
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#9A9A9A",
        "fontStyle": ""
      }
    },
    {
      "name": "Identifiers",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.property",
        "variable.other.constant",
        "variable.parameter",
        "meta.object-literal.key",
        "support.variable",
        "support.variable.property",
        "support.constant",
        "support.type.property-name",
        "support.type.property-name.css",
        "meta.template.expression",
        "meta.embedded",
        "meta.jsx.children",
        "variable.other.normal.shell",
        "variable.css",
        "string.other.link.title"
      ],
      "settings": {
        "foreground": "#D6D6D6",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and decorators",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.definition.method entity.name.function",
        "support.function.builtin",
        "support.function.misc.css",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.decorator",
        "entity.name.function.decorator.python",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "source.css entity.name.tag",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#BB9AF7",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "entity.name.type.alias",
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type.enum",
        "support.class.component",
        "support.type.python",
        "storage.type.sql"
      ],
      "settings": {
        "foreground": "#F5B35E",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "string.unquoted.plain.out.yaml",
        "markup.inline.raw",
        "markup.raw",
        "support.constant.property-value.css",
        "support.constant.font-name.css",
        "meta.property-value.css",
        "string.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#F0A27F",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers, constants, escapes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other.color",
        "keyword.other.unit.css",
        "variable.other.enummember",
        "entity.name.constant",
        "constant.other.symbol",
        "constant.character.escape",
        "constant.other.character-class.regexp",
        "keyword.control.anchor.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#F0CB8A",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.yaml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7BA7F0",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#E8E8E8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#C9C9C9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C9C9C9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#707070",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#7BA7F0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8B8B8B",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown list marks",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#7BA7F0",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#8EB69B",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#EE857D",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#7BA7F0",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#EE857D",
        "fontStyle": "underline"
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#BB9AF7"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#7BA7F0"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#D6D6D6",
      "fontStyle": "italic"
    },
    "variable.readonly": {
      "foreground": "#F0CB8A"
    },
    "variable.defaultLibrary": {
      "foreground": "#F5B35E"
    },
    "typeParameter": {
      "foreground": "#F5B35E",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#F5B35E"
    },
    "property.declaration": {
      "foreground": "#D6D6D6"
    },
    "enumMember": {
      "foreground": "#F0CB8A"
    }
  }
}